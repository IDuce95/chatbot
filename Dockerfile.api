FROM python:3.12-slim

WORKDIR /app

RUN apt-get update && apt-get install -y \
    build-essential \
    curl \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .

RUN pip install --no-cache-dir -r requirements.txt

COPY . .

RUN mkdir -p chroma_db faiss_index

EXPOSE 8000

HEALTHCHECK --interval=300s --timeout=10s --start-period=60s --retries=1 CMD curl -f http://localhost:8000/health || exit 1

CMD ["python", "-m", "uvicorn", "app.api_server:app", "--host", "0.0.0.0", "--port", "8000"]
